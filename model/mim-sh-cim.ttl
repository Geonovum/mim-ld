#
# Dit bestand bevat de shacl shapes graph voor MIM 2.0
# Het betreft de shapes graph voor een CIM
#
# WORK IN PROGRESS
#

@prefix mim: <http://modellen.mim-standaard.nl/def/mim#>.
@prefix mimdoc: <http://definities.mim-standaard.nl/id/referentie/>.
@prefix shape: <http://modellen.mim-standaard.nl/def/mim-shapes#>.

@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix si: <https://si-digital-framework.org/SI#>.

#
# Objecttype
#
shape:Objecttype a sh:NodeShape;
  sh:targetClass mim:Objecttype;
  sh:name "mim:Objecttype";
  sh:property [sh:path rdf:type; sh:hasValue mim:Objecttype];
  sh:property shape:Objecttype.naam;
  sh:property shape:Objecttype.attribuuttype;
.
shape:Objecttype.naam a sh:PropertyShape;
  sh:path mim:naam;
  sh:name "mim:naam";
  sh:order 2;
  sh:minCount 1;
  sh:maxCount 1;
  sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
.
shape:Objecttype.attribuuttype a sh:PropertyShape;
  sh:path mim:attribuuttype;
  sh:name "mim:attribuuttype";
  sh:class mim:Attribuuttype;
.

#
# Attribuuttype
#
shape:Attribuuttype a sh:NodeShape;
  sh:targetClass mim:Attribuuttype;
  sh:name "mim:Attribuuttype";
  sh:property [sh:path rdf:type; sh:hasValue mim:Attribuuttype];
  sh:property shape:Attribuuttype.naam;
  sh:property shape:Attribuuttype.waardetype;
.
shape:Attribuuttype.naam a sh:PropertyShape;
  sh:path mim:naam;
  sh:name "mim:naam";
  sh:order 2;
  sh:minCount 1;
  sh:maxCount 1;
  sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
.
shape:Attribuuttype.waardetype a sh:PropertyShape;
  sh:path mim:waardetype;
  sh:name "mim:waardetype";
  sh:class mim:Waardetype;
  sh:minCount 1;
  sh:maxCount 1;
.

#
# Waardetype
#
shape:Waardetype a sh:NodeShape;
  sh:targetClass mim:Waardetype;
  sh:name "mim:Waardetype";
  sh:property [sh:path rdf:type; sh:hasValue mim:Waardetype];
  sh:property shape:Waardetype.naam;
  sh:property shape:Waardetype.waardetype;
.
shape:Waardetype.naam a sh:PropertyShape;
  sh:path mim:naam;
  sh:name "mim:naam";
  sh:order 2;
  sh:minCount 1;
  sh:maxCount 1;
  sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
.

#
# Relatietype
#
shape:Relatietype a sh:NodeShape;
  sh:targetClass mim:Relatietype;
  sh:name "mim:Relatietype";
  sh:property [sh:path rdf:type; sh:hasValue mim:Relatietype];
  sh:property shape:Relatietype.naam;
  sh:property shape:Relatietype.propositie;
.
shape:Relatietype.naam a sh:PropertyShape;
  sh:path mim:naam;
  sh:name "mim:naam";
  sh:order 2;
  sh:minCount 1;
  sh:maxCount 1;
  sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
.
shape:Relatietype.propositie a sh:PropertyShape;
  sh:path mim:propositie;
  sh:name "mim:propositie";
  sh:class mim:Propositie;
  sh:minCount 1;
  sh:nodeKind sh:BlankNode;
.

#
# Propositie
#
shape:Propositie a sh:NodeShape;
  sh:targetClass mim:Propositie;
  sh:name "mim:Propositie";
  sh:property [sh:path rdf:type; sh:hasValue mim:Propositie];
  sh:property shape:Propositie.verwoording;
  sh:property shape:Propositie.bron;
  sh:property shape:Propositie.doel;
.
shape:Propositie.verwoording a sh:PropertyShape;
  sh:path mim:verwoording;
  sh:name "mim:verwoording";
  sh:order 3;
  sh:minCount 1;
  sh:maxCount 1;
  sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
.
shape:Propositie.bron a sh:PropertyShape;
  sh:path mim:bron;
  sh:name "mim:bron";
  sh:class mim:Rolinvulling;
  sh:minCount 1;
  sh:maxCount 1;
.
shape:Propositie.doel a sh:PropertyShape;
  sh:path mim:doel;
  sh:name "mim:doel";
  sh:class mim:Rolinvulling;
  sh:minCount 1;
  sh:maxCount 1;
.

#
# Rolinvulling
#
shape:Rolinvulling a sh:NodeShape;
  sh:targetClass mim:Rolinvulling;
  sh:name "mim:Rolinvulling";
  sh:property [sh:path rdf:type; sh:hasValue mim:Rolinvulling];
  sh:property shape:Rolinvulling.naam;
  sh:property shape:Rolinvulling.rolinvuller;
.
shape:Rolinvulling.naam a sh:PropertyShape;
  sh:path mim:naam;
  sh:name "mim:naam";
  sh:order 2;
  sh:minCount 1;
  sh:maxCount 1;
  sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
.
shape:Rolinvulling.rolinvuller a sh:PropertyShape;
  sh:path mim:rolinvuller;
  sh:name "mim:rolinvuller";
  sh:class mim:Objecttype;
  sh:minCount 1;
  sh:maxCount 1;
.
